+/// One turn's `tool_name`, straight off the row.
+fn tool_of(conn: &Connection, turn_id: i64) -> Option<String> {
+    conn.query_row(
+        "SELECT tool_name FROM turns WHERE id = ?1",
+        [turn_id],
+        |r| r.get(0),
+    )
+    .unwrap()
+}
