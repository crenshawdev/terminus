+/// One filtered search over every project.
+fn narrowed(conn: &Connection, raw: &str, filters: Filters) -> verbatim_core::Result<Response> {
+    search::run(
+        conn,
+        &config(&[]),
+        &Request::new(Query::parse(raw), Scope::Everything)
+            .filters(filters)
+            .limit(MAX_RESULTS),
+    )
+}
