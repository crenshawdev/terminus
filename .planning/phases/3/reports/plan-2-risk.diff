+    let worktree_cwd = "/data/projects/beta/.claude/worktrees/wt-a";
+    let plain = tree.transcript(1, repo_cwd);
+    let forked = tree.transcript(2, worktree_cwd);
+    assert_eq!(tree.ingest_everything().files_committed, 2);
