+/// The timestamps a response answered with, in the order it answered.
+fn stamps(response: &Response) -> Vec<String> {
+    response
+        .hits
+        .iter()
+        .map(|hit| hit.ts.clone().expect("every fixture turn carries a ts"))
+        .collect()
+}
