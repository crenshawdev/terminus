+/// The distinct projects a set of hits came from.
+fn projects_of(response: &Response) -> Vec<String> {
+    let mut out: Vec<String> = response
+        .hits
+        .iter()
+        .map(|hit| hit.project.clone().unwrap_or_default())
+        .collect();
+    out.sort();
+    out.dedup();
+    out
+}
